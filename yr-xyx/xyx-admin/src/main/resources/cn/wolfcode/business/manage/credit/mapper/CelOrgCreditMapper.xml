<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.wolfcode.business.manage.credit.mapper.CelOrgCreditMapper">
    
    <resultMap type="CelOrgCredit" id="CelOrgCreditResult">
        <result property="id"    column="id"    />
        <result property="version"    column="version"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdByName"    column="created_by_name"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedBy"    column="updated_by"    />
        <result property="updatedByName"    column="updated_by_name"    />
        <result property="updatedTime"    column="updated_time"    />
        <result property="deleted"    column="deleted"    />
        <result property="orgId"    column="org_id"    />
        <result property="eventData"    column="event_data"    />
        <result property="eventType"    column="event_type"    />
        <result property="eventDescribe"    column="event_describe"    />
        <result property="sourceType"    column="source_type"    />
    </resultMap>

    <sql id="selectCelOrgCreditVo">
        select id, version, created_by, created_by_name, created_time, updated_by, updated_by_name, updated_time, deleted, org_id, event_data, event_type, event_describe, source_type from cel_org_credit
    </sql>

    <!--<select id="selectCelOrgCreditList" parameterType="CelOrgCredit" resultMap="CelOrgCreditResult">
        <include refid="selectCelOrgCreditVo"/>
        <where>  
        </where>
    </select>-->

    <resultMap id="CelOrgCreditResultVo" type="CelOrgCreditVo">
        <result property="id" column="id"/>
        <result property="version" column="version"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdByName" column="created_by_name"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedByName" column="updated_by_name"/>
        <result property="updatedTime" column="updated_time"/>
        <result property="deleted" column="deleted"/>
        <result property="orgId" column="org_id"/>
        <result property="eventData" column="event_data"/>
        <result property="eventType" column="event_type"/>
        <result property="eventDescribe" column="event_describe"/>
        <result property="sourceType" column="source_type"/>
        <result property="organizationName" column="organization_name"/>
    </resultMap>

    <select id="selectCelOrgCreditList" resultMap="CelOrgCreditResultVo">
        select cre.*,org.organization_name  from cel_org_credit cre left join t_platform_org_list org on cre.org_id = org.id
    </select>


    
    <select id="selectCelOrgCreditById" parameterType="Long" resultMap="CelOrgCreditResult">
        <include refid="selectCelOrgCreditVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertCelOrgCredit" parameterType="CelOrgCredit" useGeneratedKeys="true" keyProperty="id">
        insert into cel_org_credit
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="version != null">version,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="createdByName != null">created_by_name,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="updatedBy != null">updated_by,</if>
            <if test="updatedByName != null">updated_by_name,</if>
            <if test="updatedTime != null">updated_time,</if>
            <if test="deleted != null">deleted,</if>
            <if test="orgId != null">org_id,</if>
            <if test="eventData != null">event_data,</if>
            <if test="eventType != null">event_type,</if>
            <if test="eventDescribe != null">event_describe,</if>
            <if test="sourceType != null">source_type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="version != null">#{version},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="createdByName != null">#{createdByName},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="updatedBy != null">#{updatedBy},</if>
            <if test="updatedByName != null">#{updatedByName},</if>
            <if test="updatedTime != null">#{updatedTime},</if>
            <if test="deleted != null">#{deleted},</if>
            <if test="orgId != null">#{orgId},</if>
            <if test="eventData != null">#{eventData},</if>
            <if test="eventType != null">#{eventType},</if>
            <if test="eventDescribe != null">#{eventDescribe},</if>
            <if test="sourceType != null">#{sourceType},</if>
         </trim>
    </insert>

    <update id="updateCelOrgCredit" parameterType="CelOrgCredit">
        update cel_org_credit
        <trim prefix="SET" suffixOverrides=",">
            <if test="version != null">version = #{version},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
            <if test="createdByName != null">created_by_name = #{createdByName},</if>
            <if test="createdTime != null">created_time = #{createdTime},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
            <if test="updatedByName != null">updated_by_name = #{updatedByName},</if>
            <if test="updatedTime != null">updated_time = #{updatedTime},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
            <if test="orgId != null">org_id = #{orgId},</if>
            <if test="eventData != null">event_data = #{eventData},</if>
            <if test="eventType != null">event_type = #{eventType},</if>
            <if test="eventDescribe != null">event_describe = #{eventDescribe},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCelOrgCreditById" parameterType="Long">
        delete from cel_org_credit where id = #{id}
    </delete>

    <delete id="deleteCelOrgCreditByIds" parameterType="String">
        delete from cel_org_credit where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>